# Copy to .env and fill in before `docker compose up`.
# COWBOT_OWNER_EMAIL is required; the rest have defaults in compose.yaml.

COWBOT_OWNER_EMAIL=owner@example.com
COWBOT_OWNER_NAME=Owner
COWBOT_WORKSPACE=Team Workspace

# Two weeks.
COWBOT_SESSION_HOURS=336

# RUST_LOG=cowbot_server=debug for more detail.
